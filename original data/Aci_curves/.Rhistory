library(tm)
library(plyr)
library(plantecophys)
library(readxl)
library(ggplot2)
library(ggpubr)
trace(plantecophys::Photosyn,edit=TRUE)
?fitaci
#read excel file
getwd()
setwd("C:/Users/jans008/OneDrive - Wageningen University & Research/PhD/Light spectrum paper/Scripts and data files for the paper/cleaned data files/Faba/Aci analysis")
Faba <- read.csv("./Faba_APAR_cleaned.csv")
Faba = Faba[Faba$Measurement_type == 'Aci_curve', ]
# check what class the data is in
sapply(Faba, class)
## visualisation, change the y as desired
ggplot(Faba, aes(x=Ci, y=Photo))+
geom_point(aes(color=PlantID))+
stat_smooth(aes(color=PlantID))
ggplot(Faba, aes(x=CO2S, y=Photo))+
geom_point(aes(color=PlantID))+
stat_smooth(aes(color=PlantID))
# Removes the datapoint at the highest Ci if assimilation is lower than the
# assimilation of the previous Ci
Faba$obs_id = seq(1, length(Faba$PlantID), by =1)
for (i in unique(Faba$PlantID)){
data = subset(Faba, Faba$PlantID == i)
data = data[order(data$Ci),]
if (data$Photo[length(data$Photo)] < data$Photo[length(data$Photo)-1]){
Faba = subset(Faba, obs_id!=data$obs_id[length(data$Photo)])
}
}
dfrd<-data.frame()
for (i in unique(Faba$PlantID))
{
f<-fitaci(subset(Faba, Faba$PlantID==i), useRd=FALSE, Tcorrect=FALSE,
varnames = list(ALEAF = 'Photo', Tleaf = 'Tleaf',
Ci = 'Ci',PPFD = 'PAR'), gmeso=0.3)
#print(c(coef(f)))
dfrd<-rbind(dfrd,c(coef(f),f$RMSE))
par(mfrow=c(1,1))
plot(f, main=i)
}
stat_summary(fun = mean, geom = 'point', shape=17, size=3)
Rd_plot = ggplot(dfrd, aes(x=Sample, y=Rd)) +
geom_boxplot() + ggtitle('Rd') +
stat_summary(fun = mean, geom = 'point', shape=17, size=3)
Vcmax_plot
Jmax_plot
Rd_plot
print(paste('average Jmax is:', mean(dfrd$Jmax), 'and std is:', sd(dfrd$Jmax)))
print(paste('average Rd is:', mean(dfrd$Rd), 'and std is:', sd(dfrd$Rd)))
###Testing population level fitting with mean values
f<-fitacis(Faba,'PlantID', useRd=FALSE, Tcorrect=FALSE, gmeso=0.3)
plot(f, how="oneplot")
ind_fits = coef(f)
#Creating categorical variables for CO2S
Faba$CO2S_cat = round(Faba$CO2S)
print(unique(Faba$CO2S_cat))
Faba$CO2S_cat = as.factor(Faba$CO2S_cat)
ggplot(Faba, aes(x=Ci, y=Photo, group = CO2S_cat))+
geom_point(aes(color=CO2S_cat))
#Group data
Faba_sel = Faba[c('PlantID', 'Photo', 'Ci', 'PAR', 'CO2S', 'CO2S_cat', 'Tleaf')]
fit_df = data.frame()
for (i in unique(Faba_sel$CO2S_cat))
{
category<-subset(Faba_sel, Faba_sel$CO2S_cat==i)
row_cat = c(i, mean(category$Photo),sd(category$Photo),
mean(category$Ci),sd(category$Ci),
mean(category$PAR),sd(category$PAR),
mean(category$CO2S),sd(category$CO2S),
mean(category$Tleaf),sd(category$Tleaf))
fit_df<-rbind(fit_df,row_cat)
}
colnames(fit_df)<-c("CO2S_cat", 'Photo_mean', 'Photo_sd', 'Ci_mean', 'Ci_sd',
'PAR_mean','PAR_sd','CO2S_mean','CO2S_sd',
'Tleaf_mean', 'Tleaf_sd')
fit_df[] <- lapply(fit_df, as.numeric)
sapply(fit_df, class)
#plot data cloud with error bars
ggplot(data = fit_df,aes(x = Ci_mean,y = Photo_mean)) +
geom_point() +
geom_errorbar(aes(ymin = Photo_mean - Photo_sd,ymax = Photo_mean + Photo_sd)) +
geom_errorbarh(aes(xmin = Ci_mean - Ci_sd,xmax = Ci_mean + Ci_sd))
#Testing pop level fitting on all data
fit_pop = fitaci(Faba, useRd=FALSE, Tcorrect=FALSE,
varnames = list(ALEAF = 'Photo', Tleaf = 'Tleaf',
Ci = 'Ci',PPFD = 'PAR'), gmeso=0.3)
print(c(coef(fit_pop)))
plot(fit_pop)
fit_pop$df
summary(fit_pop$nlsfit)
#obtain fitted line for plot
predict_df = data.frame('Ci'= 1:1000)
A_list = list()
for (i in predict_df$Ci)
{
A_list = c(A_list, fit_pop$Photosyn(Ci = i)$ALEAF)
}
predict_df$A = A_list
predict_df[] <- lapply(predict_df, as.numeric)
#Plot fit
ggplot(data = fit_df,aes(x = Ci_mean,y = Photo_mean)) +
geom_point() +
geom_errorbar(aes(ymin = Photo_mean - Photo_sd,ymax = Photo_mean + Photo_sd)) +
geom_errorbarh(aes(xmin = Ci_mean - Ci_sd,xmax = Ci_mean + Ci_sd)) +
geom_line(data = predict_df,aes(x = Ci,y = A, color= 'pop level fitting')) +
scale_color_manual(name='fitting strategy',
breaks=c('pop level fitting'),
values=c('pop level fitting'='Red'))+
labs(x = 'Ci', y = 'Assimilation rate', title = 'fitting strategies')
print(summary(fit_pop$nlsfit))
#Plot fit
ggplot(data = fit_df,aes(x = Ci_mean,y = Photo_mean)) +
geom_point() +
geom_errorbar(aes(ymin = Photo_mean - Photo_sd,ymax = Photo_mean + Photo_sd)) +
geom_errorbarh(aes(xmin = Ci_mean - Ci_sd,xmax = Ci_mean + Ci_sd)) +
geom_line(data = predict_df,aes(x = Ci,y = A, color= 'pop level fitting')) +
scale_color_manual(name='fitting strategy',
breaks=c('pop level fitting'),
values=c('pop level fitting'='Red'))+
labs(x = bquote('Ci ['*mu~bar*']'), y = bquote('Assimilation ['*mu~'mol' ~CO[2]~ m^-2~s^-1*']'), title ='Common bean')
#obtain fitted line for plot
predict_df = data.frame('Ci'= 1:1100)
A_list = list()
for (i in predict_df$Ci)
{
A_list = c(A_list, fit_pop$Photosyn(Ci = i)$ALEAF)
}
predict_df$A = A_list
predict_df[] <- lapply(predict_df, as.numeric)
#Plot fit
ggplot(data = fit_df,aes(x = Ci_mean,y = Photo_mean)) +
geom_point() +
geom_errorbar(aes(ymin = Photo_mean - Photo_sd,ymax = Photo_mean + Photo_sd)) +
geom_errorbarh(aes(xmin = Ci_mean - Ci_sd,xmax = Ci_mean + Ci_sd)) +
geom_line(data = predict_df,aes(x = Ci,y = A, color= 'pop level fitting')) +
scale_color_manual(name='fitting strategy',
breaks=c('pop level fitting'),
values=c('pop level fitting'='Red'))+
labs(x = bquote('Ci ['*mu~bar*']'), y = bquote('Assimilation ['*mu~'mol' ~CO[2]~ m^-2~s^-1*']'), title ='Common bean')
print(summary(fit_pop$nlsfit))
