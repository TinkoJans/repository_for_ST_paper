#select parameter values
a1=a2=10
b=g=2
#select ranges to plot
v=seq(0,15,0.1)
u=seq(0,15,0.1)
#define the curves for the nullclines
uss=a1/(1+v^b)
vss=a2/(1+u^g)
#do the ploint
plot(u, vss, type="l", xlim=c(0,12), ylim=c(0,12), xlab="u", ylab="v", col=3, lwd=3)
points(uss, v, type="l", col=1, lwd=3)  #this adds a graph to an existing plot
legend("topright", c("uss", "vss"), col=c(1,3), lty=1)  #add leged
plot(U_1~V, type = 'l', col = "red", lwd =3)
lines(U_2~V, col = "green", lwd= 3)
legend("topright", c("U_1", "U_2"))
legend("topright", c("U_1", "U_2"), col = c(1,3)
legend("topright", c("U_1", "U_2"), col = c(1,3)
legend("topright", c("U_1", "U_2"), col = c(1,3))
legend("topright", c("U_1", "U_2"), col = c(1,3), lty=1)
